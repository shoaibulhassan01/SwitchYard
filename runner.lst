   625                                  spawn_train:                 ; send a new train when the countdown ends
   626 000004E4 60                          pusha
   627 000004E5 FE0E[5000]                  dec byte [spawn_cnt]
   628 000004E9 7560                        jnz sp_done              ; not time yet
   629                                  
   630 000004EB 31F6                        xor si, si               ; look for a free slot
   631                                  sp_find:
   632 000004ED 80BC[6400]00                cmp byte [t_on + si], 0
   633 000004F2 7408                        je sp_found
   634 000004F4 46                          inc si
   635 000004F5 83FE08                      cmp si, 8
   636 000004F8 72F3                        jb sp_find
   637 000004FA EB45                        jmp sp_reset             ; no free slot, try again later
   638                                  
   639                                  sp_found:
   640 000004FC C684[6400]01                mov byte [t_on + si], 1  ; train is running now
   641 00000501 C684[7400]08                mov byte [t_col + si], 8 ; both entries start at column 8
   642 00000506 C684[7C00]00                mov byte [t_dr + si], 0
   643 0000050B C684[8400]01                mov byte [t_dc + si], 1  ; going east
   644                                  
   645 00000510 803E[4F00]00                cmp byte [next_entry], 0
   646 00000515 7515                        jne sp_entry2
   647                                  
   648 00000517 C684[6C00]03                mov byte [t_row + si], 3 ; Entry 1 (row 3)
   649 0000051C B104                        mov cl, 4
   650 0000051E E8F4FD                      call rand                ; random destination A, B, C or D (0-3)
   651 00000521 8884[8C00]                  mov [t_dest + si], al
   652 00000525 C606[4F00]01                mov byte [next_entry], 1 ; next train comes from Entry 2
   653 0000052A EB15                        jmp sp_reset
   654                                  
   655                                  sp_entry2:
   656 0000052C C684[6C00]13                mov byte [t_row + si], 19 ; Entry 2 (row 19)
   657 00000531 B103                        mov cl, 3
   658 00000533 E8DFFD                      call rand                ; random destination B, C or D (1-3), A is not reachable
   659 00000536 FEC0                        inc al
   660 00000538 8884[8C00]                  mov [t_dest + si], al
   661 0000053C C606[4F00]00                mov byte [next_entry], 0 ; next train comes from Entry 1
   662                                  
   663                                  sp_reset:
   664 00000541 B10A                        mov cl, 10
   665 00000543 E8CFFD                      call rand                ; random 0-9
