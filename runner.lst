   524 00000401 8A84[8400]                  mov al, [t_dc + si]
   525 00000405 0084[7400]                  add [t_col + si], al
   526                                  
   527 00000409 E80B00                      call check_switches      ; turn if train is on a switch
   528 0000040C E89D00                      call check_station       ; remove train if it reached a station
