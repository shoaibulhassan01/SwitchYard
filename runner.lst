   519 000003F2 80BC[6400]00                cmp byte [t_on + si], 0
   520 000003F7 7416                        je mv_next               ; slot is free, skip
   521                                  
   522 000003F9 8A84[7C00]                  mov al, [t_dr + si]      ; one step in current direction
