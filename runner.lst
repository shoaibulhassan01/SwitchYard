   595                                  check_station:               ; in: SI = train number
   596 000004AC 31DB                        xor bx, bx               ; BX = position in stops table
   597                                  cst_loop:
   598 000004AE 8A87[5100]                  mov al, [stops + bx]     ; station row
   599 000004B2 3A84[6C00]                  cmp al, [t_row + si]
   600 000004B6 7523                        jne cst_next
   601 000004B8 8A87[5200]                  mov al, [stops + bx + 1] ; station column
   602 000004BC 3A84[7400]                  cmp al, [t_col + si]
   603 000004C0 7519                        jne cst_next
   604                                  
   605 000004C2 C684[6400]00                mov byte [t_on + si], 0  ; train reached a station, it disappears
   606                                  
   607 000004C7 8A87[5300]                  mov al, [stops + bx + 2] ; id of this station
   608 000004CB 3A84[8C00]                  cmp al, [t_dest + si]    ; same as train's destination?
   609 000004CF 7505                        jne cst_wrong
   610 000004D1 FE06[4B00]                  inc byte [correct_cnt]   ; right station
   611 000004D5 C3                          ret
   612                                  cst_wrong:
   613 000004D6 FE06[4C00]                  inc byte [wrong_cnt]     ; wrong station
   614 000004DA C3                          ret
   615                                  
   616                                  cst_next:
