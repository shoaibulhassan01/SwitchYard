  1099                                  
  1100                                  sp_found:
  1101 000009B7 C684[5201]01                mov byte [t_on + si], 1  ; train is running now
  1102 000009BC C684[6201]08                mov byte [t_col + si], 8 ; both entries start at column 8
  1103 000009C1 C684[6A01]00                mov byte [t_dr + si], 0
  1104 000009C6 C684[7201]01                mov byte [t_dc + si], 1  ; going east
