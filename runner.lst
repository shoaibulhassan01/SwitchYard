   942 00000871 750A                        jne cw_plus
   943 00000873 C684[6A01]FF                mov byte [t_dr + si], 0FFh   ; state 1 = north (-1)
   944 00000878 C684[7201]00                mov byte [t_dc + si], 0
   945                                  
   946                                  cw_plus:                     ; --- + (10,14): always east ---
   947 0000087D 80BC[5A01]0A                cmp byte [t_row + si], 10
   948 00000882 7511                        jne cw_s3
   949 00000884 80BC[6201]0E                cmp byte [t_col + si], 14
   950 00000889 750A                        jne cw_s3
   951 0000088B C684[6A01]00                mov byte [t_dr + si], 0
   952 00000890 C684[7201]01                mov byte [t_dc + si], 1  ; east
   953                                  
   954                                  cw_s3:                       ; --- Switch 3 (10,30): state 0 north, state 1 east ---
   955 00000895 80BC[5A01]0A                cmp byte [t_row + si], 10
   956 0000089A 7522                        jne cw_s4
   957 0000089C 80BC[6201]1E                cmp byte [t_col + si], 30
   958 000008A1 751B                        jne cw_s4
   959 000008A3 C684[6A01]00                mov byte [t_dr + si], 0  ; east
   960 000008A8 C684[7201]01                mov byte [t_dc + si], 1
   961 000008AD 803E[AD01]00                cmp byte [state + 2], 0
   962 000008B2 750A                        jne cw_s4
   963 000008B4 C684[6A01]FF                mov byte [t_dr + si], 0FFh   ; state 0 = north (-1)
   964 000008B9 C684[7201]00                mov byte [t_dc + si], 0
   965                                  
   966                                  cw_s4:                       ; --- Switch 4 (10,46): state 0 east, state 1 south ---
   967 000008BE 80BC[5A01]0A                cmp byte [t_row + si], 10
   968 000008C3 7522                        jne cw_end
   969 000008C5 80BC[6201]2E                cmp byte [t_col + si], 46
   970 000008CA 751B                        jne cw_end
   971 000008CC C684[6A01]00                mov byte [t_dr + si], 0  ; east
   972 000008D1 C684[7201]01                mov byte [t_dc + si], 1
   973 000008D6 803E[AE01]01                cmp byte [state + 3], 1
   974 000008DB 750A                        jne cw_end
   975 000008DD C684[6A01]01                mov byte [t_dr + si], 1  ; state 1 = south
   976 000008E2 C684[7201]00                mov byte [t_dc + si], 0
   977                                  
   978                                  cw_end:
   979 000008E7 C3                          ret
