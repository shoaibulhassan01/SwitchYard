   539                                  check_switches:              ; in: SI = train number
   540                                  
   541                                      ; --- Switch 1 (3,14): state 1 then south ---
   542 00000417 80BC[6C00]03                cmp byte [t_row + si], 3
   543 0000041C 7518                        jne cw_s2
   544 0000041E 80BC[7400]0E                cmp byte [t_col + si], 14
   545 00000423 7511                        jne cw_s2
   546 00000425 803E[A500]00                cmp byte [state], 0
   547 0000042A 740A                        je cw_s2                 ; state 0 = east, same direction
   548 0000042C C684[7C00]01                mov byte [t_dr + si], 1  ; else south
   549 00000431 C684[8400]00                mov byte [t_dc + si], 0
   550                                  
   551                                  cw_s2:                       ; --- Switch 2 (19,14): state 1 then north ---
   552 00000436 80BC[6C00]13                cmp byte [t_row + si], 19
   553 0000043B 7518                        jne cw_plus
   554 0000043D 80BC[7400]0E                cmp byte [t_col + si], 14
   555 00000442 7511                        jne cw_plus
   556 00000444 803E[A600]01                cmp byte [state + 1], 1
   557 00000449 750A                        jne cw_plus              ; state 0 = east, same direction
   558 0000044B C684[7C00]FF                mov byte [t_dr + si], 0FFh   ; -1 = north
   559 00000450 C684[8400]00                mov byte [t_dc + si], 0
   560                                  
   561                                  cw_plus:                     ; --- + (10,14): always east ---
   562 00000455 80BC[6C00]0A                cmp byte [t_row + si], 10
   563 0000045A 7511                        jne cw_s3
   564 0000045C 80BC[7400]0E                cmp byte [t_col + si], 14
   565 00000461 750A                        jne cw_s3
   566 00000463 C684[7C00]00                mov byte [t_dr + si], 0
   567 00000468 C684[8400]01                mov byte [t_dc + si], 1  ; east
   568                                  
   569                                  cw_s3:                       ; --- Switch 3 (10,30): state 0 then north ---
   570 0000046D 80BC[6C00]0A                cmp byte [t_row + si], 10
   571 00000472 7518                        jne cw_s4
   572 00000474 80BC[7400]1E                cmp byte [t_col + si], 30
   573 00000479 7511                        jne cw_s4
   574 0000047B 803E[A700]00                cmp byte [state + 2], 0
   575 00000480 750A                        jne cw_s4                ; state 1 = east, same direction
   576 00000482 C684[7C00]FF                mov byte [t_dr + si], 0FFh   ; -1 = north
   577 00000487 C684[8400]00                mov byte [t_dc + si], 0
   578                                  
   579                                  cw_s4:                       ; --- Switch 4 (10,46): state 1 then south ---
   580 0000048C 80BC[6C00]0A                cmp byte [t_row + si], 10
   581 00000491 7518                        jne cw_end
   582 00000493 80BC[7400]2E                cmp byte [t_col + si], 46
   583 00000498 7511                        jne cw_end
   584 0000049A 803E[A800]01                cmp byte [state + 3], 1
   585 0000049F 750A                        jne cw_end               ; state 0 = east, same direction
   586 000004A1 C684[7C00]01                mov byte [t_dr + si], 1  ; south
   587 000004A6 C684[8400]00                mov byte [t_dc + si], 0
   588                                  
   589                                  cw_end:
   590 000004AB C3                          ret
   591                                  
