   675                                  delay:                       ; wait until 2 timer ticks have passed
   676                                  
   677 0000054D 50                          push ax
   678 0000054E 53                          push bx
   679 0000054F 51                          push cx
   680 00000550 52                          push dx
   681 00000551 30E4                        xor ah, ah
   682 00000553 CD1A                        int 1Ah                  ; DX = current tick
   683 00000555 89D3                        mov bx, dx               ; remember the start tick
   684                                  d_wait:
