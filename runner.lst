  1058 00000974 740D                        je eb_next
  1059 00000976 3A87[5A01]                  cmp al, [t_row + bx]
  1060 0000097A 7507                        jne eb_next
  1061 0000097C 80BF[6201]08                cmp byte [t_col + bx], 8 ; entrance cell is column 8
