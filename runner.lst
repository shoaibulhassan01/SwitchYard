   984                                  check_station:               ; in: SI = train number
   985 000008E8 31DB                        xor bx, bx               ; BX = position in stops table
   986                                  cst_loop:
   987 000008EA 8A87[3F01]                  mov al, [stops + bx]     ; station row
   988 000008EE 3A84[5A01]                  cmp al, [t_row + si]
   989 000008F2 7526                        jne cst_next
   990 000008F4 8A87[4001]                  mov al, [stops + bx + 1] ; station column
   991 000008F8 3A84[6201]                  cmp al, [t_col + si]
   992 000008FC 751C                        jne cst_next
   993                                  
   994 000008FE C684[5201]00                mov byte [t_on + si], 0  ; train reached a station, it disappears
   995                                  
   996 00000903 8A87[4101]                  mov al, [stops + bx + 2] ; id of this station
   997 00000907 3A84[7A01]                  cmp al, [t_dest + si]    ; same as train's destination?
   998 0000090B 7508                        jne cst_wrong
   999 0000090D FE06[2901]                  inc byte [correct_cnt]   ; right station
  1000 00000911 E80F00                      call check_speed         ; maybe time for the speed increase
  1001 00000914 C3                          ret
  1002                                  cst_wrong:
  1003 00000915 FE06[2A01]                  inc byte [wrong_cnt]     ; wrong station
  1004 00000919 C3                          ret
  1005                                  
  1006                                  cst_next:
  1007 0000091A 83C303                      add bx, 3                ; next stop (3 bytes each)
  1008 0000091D 83FB0F                      cmp bx, 15               ; 5 stops x 3 bytes
  1009 00000920 72C8                        jb cst_loop
  1010 00000922 C3                          ret
  1011                                  
  1012                                  
  1013                                  
  1014                                  
  1015                                  check_speed:                 ; one-time speed increase when the score reaches the goal
  1016 00000923 803E[3301]00                cmp byte [speed_done], 0
  1017 00000928 7525                        jne csp_done             ; already done
  1018 0000092A A0[2901]                    mov al, [correct_cnt]
  1019 0000092D 3A06[3401]                  cmp al, [speed_goal]
  1020 00000931 721C                        jb csp_done              ; goal not reached yet
  1021                                  
  1022 00000933 C606[3301]01                mov byte [speed_done], 1
  1023 00000938 D02E[3601]                  shr byte [move_interval], 1  ; halve the interval (integer division)
  1024 0000093C 7505                        jnz csp_clamp
  1025 0000093E C606[3601]01                mov byte [move_interval], 1  ; minimum is 1 tick
  1026                                  csp_clamp:
  1027 00000943 A0[3601]                    mov al, [move_interval]  ; the running countdown must not be longer than new interval
  1028 00000946 3806[3701]                  cmp [move_cnt], al
  1029 0000094A 7603                        jbe csp_done
  1030 0000094C A2[3701]                    mov [move_cnt], al
  1031                                  csp_done:
  1032 0000094F C3                          ret
  1033                                  
  1034                                  
  1035                                  
  1036                                  
  1037                                  check_end:                   ; sets result: 1 = win, 2 = lose
  1038 00000950 A0[2901]                    mov al, [correct_cnt]
  1039 00000953 3A06[3501]                  cmp al, [win_goal]
  1040 00000957 7206                        jb ce_lose
  1041 00000959 C606[3101]01                mov byte [result], 1     ; enough correct deliveries
  1042 0000095E C3                          ret
  1043                                  ce_lose:
